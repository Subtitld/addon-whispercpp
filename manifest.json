{
  "manifest_version": 1,
  "id": "whispercpp",
  "version": "26.11.1",
  "display_name": "Whisper (offline)",
  "summary": "Offline speech-to-text with whisper.cpp. CPU only, no torch. The chosen GGML model downloads once on first use (base ~142 MB, large-v3 ~2.9 GB) into Subtitld's shared model cache, so models downloaded by earlier Subtitld versions are reused.",
  "author": "Subtitld",
  "homepage": "https://github.com/Subtitld/addon-whispercpp",
  "license": "Apache-2.0",
  "executable": "bin/whispercpp-addon",
  "protocol": 1,
  "startup_timeout_sec": 30,
  "platforms": [
    "linux",
    "macos",
    "windows",
    "haiku"
  ],
  "haiku_packages": [
    "python3.14",
    "numpy_python3.14",
    "requests_python3.14",
    "platformdirs_python3.14",
    "certifi_python3.14"
  ],
  "tasks": [
    "asr.transcribe"
  ],
  "languages": [
    "af",
    "am",
    "ar",
    "as",
    "az",
    "ba",
    "be",
    "bg",
    "bn",
    "bo",
    "br",
    "bs",
    "ca",
    "cs",
    "cy",
    "da",
    "de",
    "el",
    "en",
    "es",
    "et",
    "eu",
    "fa",
    "fi",
    "fo",
    "fr",
    "gl",
    "gu",
    "ha",
    "haw",
    "he",
    "hi",
    "hr",
    "ht",
    "hu",
    "hy",
    "id",
    "is",
    "it",
    "ja",
    "jw",
    "ka",
    "kk",
    "km",
    "kn",
    "ko",
    "la",
    "lb",
    "ln",
    "lo",
    "lt",
    "lv",
    "mg",
    "mi",
    "mk",
    "ml",
    "mn",
    "mr",
    "ms",
    "mt",
    "my",
    "ne",
    "nl",
    "nn",
    "no",
    "oc",
    "pa",
    "pl",
    "ps",
    "pt",
    "ro",
    "ru",
    "sa",
    "sd",
    "si",
    "sk",
    "sl",
    "sn",
    "so",
    "sq",
    "sr",
    "su",
    "sv",
    "sw",
    "ta",
    "te",
    "tg",
    "th",
    "tk",
    "tl",
    "tr",
    "tt",
    "uk",
    "ur",
    "uz",
    "vi",
    "yi",
    "yo",
    "zh"
  ],
  "models": [
    {
      "id": "tiny",
      "display_name": "Tiny",
      "file": "ggml-tiny.bin",
      "size_mb": 75,
      "english_only": false,
      "license": "MIT"
    },
    {
      "id": "tiny.en",
      "display_name": "Tiny (English only)",
      "file": "ggml-tiny.en.bin",
      "size_mb": 75,
      "english_only": true,
      "license": "MIT"
    },
    {
      "id": "base",
      "display_name": "Base",
      "file": "ggml-base.bin",
      "size_mb": 142,
      "english_only": false,
      "license": "MIT",
      "default": true
    },
    {
      "id": "base.en",
      "display_name": "Base (English only)",
      "file": "ggml-base.en.bin",
      "size_mb": 142,
      "english_only": true,
      "license": "MIT"
    },
    {
      "id": "small",
      "display_name": "Small",
      "file": "ggml-small.bin",
      "size_mb": 466,
      "english_only": false,
      "license": "MIT"
    },
    {
      "id": "small.en",
      "display_name": "Small (English only)",
      "file": "ggml-small.en.bin",
      "size_mb": 466,
      "english_only": true,
      "license": "MIT"
    },
    {
      "id": "medium",
      "display_name": "Medium",
      "file": "ggml-medium.bin",
      "size_mb": 1500,
      "english_only": false,
      "license": "MIT"
    },
    {
      "id": "medium.en",
      "display_name": "Medium (English only)",
      "file": "ggml-medium.en.bin",
      "size_mb": 1500,
      "english_only": true,
      "license": "MIT"
    },
    {
      "id": "large-v3",
      "display_name": "Large v3",
      "file": "ggml-large-v3.bin",
      "size_mb": 2900,
      "english_only": false,
      "license": "MIT"
    }
  ],
  "disk_required_mb": 250,
  "ram_required_mb": 512,
  "config_schema": {
    "fields": [
      {
        "key": "model",
        "type": "select",
        "label": "Model",
        "default": "base",
        "options": [
          "tiny",
          "tiny.en",
          "base",
          "base.en",
          "small",
          "small.en",
          "medium",
          "medium.en",
          "large-v3"
        ],
        "help": "Larger models are more accurate and much slower. Multilingual models (\"base\", \"small\", ...) handle every language Whisper supports; \".en\" models are English-only and slightly faster. Downloaded once on first use (75 MB ... 3.1 GB)."
      },
      {
        "key": "threads",
        "type": "select",
        "label": "CPU threads",
        "default": "0",
        "options": [
          "0",
          "1",
          "2",
          "4",
          "8",
          "16"
        ],
        "help": "0 = auto (whisper.cpp uses up to 4 threads)."
      },
      {
        "key": "phrase_grouping",
        "type": "bool",
        "label": "Group output by phrases",
        "default": true,
        "help": "Re-merge whisper.cpp's raw segments into one subtitle row per sentence. Whisper segments at its own decoding cadence, which often slices mid-sentence. Turn off to keep whisper's native segmentation."
      },
      {
        "key": "models_dir",
        "type": "file",
        "label": "Models folder",
        "default": "",
        "help": "Leave empty to share Subtitld's model cache. To use another folder, type its path, or browse to any file inside it."
      }
    ]
  }
}
